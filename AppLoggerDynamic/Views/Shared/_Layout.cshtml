<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AppLogger</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="app-wrapper">

    <!-- ── Sidebar ── -->
    <nav class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-dot"></span>
            AppLogger
        </div>

        <div class="sidebar-section">Monitoring</div>
        <ul class="sidebar-nav">
            <li>
                <a href="/dashboard" class="@(ViewData["Nav"]?.ToString() == "dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li>
                <a href="/services" class="@(ViewData["Nav"]?.ToString() == "services" ? "active" : "")">
                    <i class="bi bi-hdd-network"></i> Services
                </a>
            </li>
        </ul>

        <div class="sidebar-section">Observability</div>
        <ul class="sidebar-nav">
            <li>
                <a href="/logs" class="@(ViewData["Nav"]?.ToString() == "logs" ? "active" : "")">
                    <i class="bi bi-journal-text"></i> Log Explorer
                </a>
            </li>
            <li>
                <a href="/alerts" class="@(ViewData["Nav"]?.ToString() == "alerts" ? "active" : "")">
                    <i class="bi bi-bell"></i> Alerts
                </a>
            </li>
        </ul>

        <div class="mt-auto sidebar-footer">
            <a href="/logout" class="btn btn-outline-secondary btn-sm w-100 text-white border-secondary">
                <i class="bi bi-box-arrow-left"></i> Sign out
            </a>
        </div>
    </nav>

    <!-- ── Main content ── -->
    <div class="main-content d-flex flex-column">
        @RenderBody()
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
