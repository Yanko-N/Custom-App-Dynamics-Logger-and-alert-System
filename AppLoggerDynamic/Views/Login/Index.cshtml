@{
    Layout = null;
    ViewData["Title"] = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - AppLogger</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <span class="logo-dot"></span>
            <span>AppLogger</span>
        </div>

        <h5 class="fw-semibold text-dark mb-1">Sign in</h5>
        <p class="text-muted small mb-4">Enter your API key to access the dashboard.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 small">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
            </div>
        }

        <form method="post" action="/login">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small fw-medium text-dark">API Key</label>
                <input type="password"
                       name="apiKey"
                       class="form-control"
                       placeholder="Paste your API key…"
                       autofocus
                       autocomplete="off" />
            </div>
            <button type="submit" class="btn btn-primary w-100">
                Sign in
            </button>
        </form>

        <hr class="my-4" />
        <p class="text-muted small text-center mb-0">
            Don't have an API key? Ask your account admin or create one via the REST API.
        </p>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
