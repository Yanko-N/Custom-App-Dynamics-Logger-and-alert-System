@model List<Domain.Entities.Service>
@{
    ViewData["Title"] = "Services";
    ViewData["Nav"] = "services";
}

<div class="page-header">
    <h1><i class="bi bi-hdd-network me-2 text-primary"></i>Services</h1>
    <span class="text-muted small">Register services via the REST API using your API key.</span>
</div>

<div class="page-body">
    <div class="card">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-hdd-network display-5"></i>
                <p class="mt-2">No services registered yet.</p>
                <p class="small">Use <code>POST /api/service</code> with your API key to register one.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Environment</th>
                            <th>Version</th>
                            <th>Registered</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in Model)
                        {
                            var envClass = svc.Environment?.ToLower() switch
                            {
                                "production" => "env-production",
                                "staging" => "env-staging",
                                "development" or "dev" => "env-development",
                                _ => "env-default"
                            };
                            <tr>
                                <td class="fw-medium">@svc.Name</td>
                                <td>
                                    <span class="env-badge @envClass">@svc.Environment</span>
                                </td>
                                <td class="text-muted small">v@(svc.Version)</td>
                                <td class="text-muted small">@svc.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a href="/logs?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-journal-text me-1"></i>Logs
                                    </a>
                                    <a href="/alerts?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-bell me-1"></i>Alerts
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="mt-3 p-3 rounded border bg-white small text-muted">
        <strong>Register a service via API</strong><br />
        <code>POST /api/service</code> with header <code>X-Api-Key: &lt;your-key&gt;</code> and body:
        <pre class="mt-2 mb-0 bg-light p-2 rounded">{ "name": "my-api", "environment": "production", "version": "1.0.0" }</pre>
    </div>
</div>
