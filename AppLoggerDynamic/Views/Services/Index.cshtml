@model List<Domain.Entities.Service>
@{
    ViewData["Title"] = "Services";
    ViewData["Nav"] = "services";
}

<div class="page-header">
    <div>
        <h1><i class="bi bi-hdd-network me-2 text-primary"></i>Services</h1>
        <div class="text-muted small mt-1">Applications sending logs to this system</div>
    </div>
    <a href="/services/create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Service
    </a>
</div>

<div class="page-body">
    <div class="card border-0 shadow-sm">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-hdd-network display-5 d-block mb-3"></i>
                <p class="mt-2 mb-3">No services registered yet.</p>
                <a href="/services/create" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Create your first service
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Environment</th>
                            <th>Version</th>
                            <th>Registered</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in Model)
                        {
                            var envClass = svc.Environment?.ToLower() switch
                            {
                                "production" => "env-production",
                                "staging" => "env-staging",
                                "development" or "dev" => "env-development",
                                _ => "env-default"
                            };
                            <tr>
                                <td class="fw-medium">@svc.Name</td>
                                <td>
                                    <span class="env-badge @envClass">@svc.Environment</span>
                                </td>
                                <td class="text-muted small">v@(svc.Version)</td>
                                <td class="text-muted small">@svc.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a href="/logs?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-journal-text me-1"></i>Logs
                                    </a>
                                    <a href="/alerts?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-bell me-1"></i>Alerts
                                    </a>
                                    <a href="/hooks?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-link-45deg me-1"></i>Hooks
                                    </a>
                                    <a href="/services/edit/@svc.Id" class="btn btn-sm btn-outline-secondary me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="/services/delete/@svc.Id" class="d-inline"
                                          onsubmit="return confirm('Delete service &quot;@svc.Name&quot;? This cannot be undone.')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
