@model List<Domain.Entities.Service>
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "dashboard";
}

<div class="page-header">
    <h1><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h1>
    <a href="/services" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-plus-lg me-1"></i>Register Service
    </a>
</div>

<div class="page-body">

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-hdd-network display-4 text-muted"></i>
            <p class="mt-3 text-muted">No services registered yet.</p>
            <a href="/services" class="btn btn-primary btn-sm mt-1">Register your first service</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var svc in Model)
            {
                var envClass = svc.Environment?.ToLower() switch
                {
                    "production" => "env-production",
                    "staging" => "env-staging",
                    "development" or "dev" => "env-development",
                    _ => "env-default"
                };
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="service-card">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div>
                                <div class="fw-semibold text-dark">@svc.Name</div>
                                <div class="text-muted small">v@(svc.Version)</div>
                            </div>
                            <span class="env-badge @envClass">@svc.Environment</span>
                        </div>
                        <div class="text-muted" style="font-size:.72rem;">
                            Registered @svc.RegisteredAt.ToString("yyyy-MM-dd")
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex gap-2">
                            <a href="/logs?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-journal-text me-1"></i>Logs
                            </a>
                            <a href="/alerts?serviceId=@svc.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-bell me-1"></i>Alerts
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
