@model AppLoggerDynamic.ViewModels.HookFormViewModel
@{
    ViewData["Title"] = "Edit Webhook";
    ViewData["Nav"] = "hooks";
}

<div class="page-header">
    <h1><i class="bi bi-link-45deg me-2 text-primary"></i>Edit Webhook</h1>
    <a href="/hooks?serviceId=@Model.ServiceId" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="page-body">
    <div class="card border-0 shadow-sm" style="max-width:640px;">
        <div class="card-header bg-white border-bottom fw-semibold text-secondary d-flex align-items-center gap-2">
            <i class="bi bi-sliders text-primary"></i> Webhook configuration
        </div>
        <div class="card-body p-4">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger d-flex align-items-start gap-2 py-2 small">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
                    <div>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form method="post" action="/hooks/edit/@Model.Id">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ServiceId" value="@Model.ServiceId" />

                <!-- Name -->
                <div class="mb-4">
                    <label class="form-label fw-semibold small text-uppercase text-muted">Name</label>
                    <input type="text" name="Name" value="@Model.Name" class="form-control shadow-none" required />
                </div>

                <!-- URL -->
                <div class="mb-4">
                    <label class="form-label fw-semibold small text-uppercase text-muted">Endpoint URL</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-link text-muted"></i>
                        </span>
                        <input type="url" name="Url" value="@Model.Url"
                               class="form-control border-start-0 shadow-none" required />
                    </div>
                </div>

                <!-- Secret -->
                <div class="mb-4">
                    <label class="form-label fw-semibold small text-uppercase text-muted">
                        Secret <span class="text-muted fw-normal">(optional)</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-key text-muted"></i>
                        </span>
                        <input type="text" name="Secret" value="@Model.Secret"
                               class="form-control border-start-0 shadow-none font-monospace"
                               placeholder="Leave blank to clear the existing secret" />
                    </div>
                    <div class="form-text">Leave blank to remove the current secret</div>
                </div>

                <!-- Active toggle -->
                <div class="mb-4 p-3 bg-light rounded border">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true"
                               id="isActiveCheck" @(Model.IsActive ? "checked" : "") />
                        <label class="form-check-label fw-semibold" for="isActiveCheck">
                            Webhook is active
                        </label>
                        <div class="text-muted small mt-1">
                            When disabled, this webhook will not receive any deliveries.
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Save changes
                    </button>
                    <a href="/hooks?serviceId=@Model.ServiceId" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
